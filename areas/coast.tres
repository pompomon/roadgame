[resource]
script = ExtResource("1_area")
id = &"coast"
display_name = "Coast"
props = Array[ExtResource("props_script")]([ExtResource("prop_dune_grass"), ExtResource("prop_beach_hut"), ExtResource("prop_umbrella"), ExtResource("prop_driftwood"), ExtResource("prop_shell"), ExtResource("prop_rock"), ExtResource("prop_lighthouse")])
