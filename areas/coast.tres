ground = ExtResource("art_ground")
ground_edge = ExtResource("art_edge")
min_straight = 20
max_straight = 20
straight_accel = 0.7
junction_brake_distance = 1.5
junction_speed = 2.4
offroad_speed_mult = 0.45
offroad_damage_per_sec = 35.0
