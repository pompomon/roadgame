#!/usr/bin/env python3
"""Fake date for tools/agent/test/scenarios.py: the time is the clock in $FAKE_DIR/clock, which the
fake sleep advances. Takes date's -u and +FORMAT, as the scripts call it."""
import os
import sys
import time

with open(os.path.join(os.environ["FAKE_DIR"], "clock")) as f:
    now = int(f.read())
args = sys.argv[1:]
formats = [a[1:] for a in args if a.startswith("+")]
if len(formats) != 1 or any(a not in ("-u", "+" + formats[0]) for a in args):
    sys.exit("fake date: takes only -u and +FORMAT, not: " + " ".join(args))
if formats[0] == "%s":
    print(now)
else:
    print(time.strftime(formats[0], time.gmtime(now) if "-u" in args else time.localtime(now)))
