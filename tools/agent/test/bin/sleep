#!/usr/bin/env python3
"""Fake sleep for tools/agent/test/scenarios.py: advances the fake date's clock at once, and logs
the call to calls.log."""
import os
import sys

d = os.environ["FAKE_DIR"]
clock = os.path.join(d, "clock")
with open(clock) as f:
    now = int(f.read())
with open(clock, "w") as f:
    f.write(str(now + int(sys.argv[1])))
with open(os.path.join(d, "calls.log"), "a") as log:
    log.write(f"sleep {sys.argv[1]} \n")
