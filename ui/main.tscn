[gd_scene format=3]

[ext_resource type="Script" path="res://ui/main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://world/world.tscn" id="2_world"]
[ext_resource type="Script" path="res://car/input_router.gd" id="3_input"]
[ext_resource type="Script" path="res://world/camera_rig.gd" id="4_camera"]
[ext_resource type="PackedScene" path="res://ui/hud.tscn" id="5_hud"]

[node name="Main" type="Node"]
script = ExtResource("1_main")

[node name="World" parent="." instance=ExtResource("2_world")]
unique_name_in_owner = true

[node name="Camera" type="Camera2D" parent="."]
unique_name_in_owner = true
script = ExtResource("4_camera")

[node name="InputRouter" type="Node" parent="."]
unique_name_in_owner = true
process_mode = 3
script = ExtResource("3_input")

[node name="UI" type="CanvasLayer" parent="."]

[node name="HUD" parent="UI" instance=ExtResource("5_hud")]
unique_name_in_owner = true
